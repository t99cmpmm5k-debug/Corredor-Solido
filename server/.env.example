# Copia este archivo a ".env" (nunca subas el .env real al repo) y rellena
# con los datos reales -- ver README.md de esta carpeta.

PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=corredor_solido
DB_USER=
DB_PASSWORD=

# Cadena larga y aleatoria, distinta en cada entorno -- firma los tokens de
# sesión (JWT). Si se filtra, cualquiera podría fabricar sesiones válidas.
JWT_SECRET=

# Origen(es) del frontend permitidos para llamar a esta API (CORS),
# separados por coma si hay más de uno. Ej: https://tudominio.com (sin
# barra final) -- pendiente de decidir el dominio/subdominio real.
CORS_ORIGIN=

# Envío de emails transaccionales (verificación de cuenta, recuperación de
# contraseña) vía Resend -- ver server/src/email.js. API key de tu cuenta
# de Resend.
RESEND_API_KEY=

# Remitente de esos emails -- tiene que ser de un dominio verificado en tu
# cuenta de Resend (Resend rechaza el envío si no lo está). Ej:
# "Corredor Sólido <no-reply@corredorsolido.es>"
EMAIL_FROM=

# Origen del FRONTEND (no de esta API) -- se usa para construir los
# enlaces de los emails (?verify_token=.../?reset_token=...). A diferencia
# de CORS_ORIGIN, aquí SÍ lleva barra final: el frontend vive bajo una
# subruta en GitHub Pages (ver vite.config.js "base") y sin la barra la
# URL no resuelve al index.html de la SPA. Ej:
# https://tuusuario.github.io/Corredor-Solido/
FRONTEND_URL=

# API key de tu cuenta de ArcGIS Location Platform (gratuita, ver
# location.arcgis.com), con el privilegio "premium:user:basemaps" --
# necesaria para el proxy de tiles de satélite (ver routes/tiles.js).
# Opcional: sin ella, /api/tiles/satellite/* responde 503 en vez de tumbar
# el arranque entero (no está en REQUIRED_ENV_VARS a propósito -- es una
# capa visual opcional, no debe poder romper login/sync). Esta clave NUNCA
# debe llegar al frontend -- el proxy existe precisamente para que no haga
# falta exponerla ahí.
ESRI_API_KEY=

# API key de la API de Claude (console.anthropic.com) -- la usa POST
# /api/extract-document (routes/extract.js) para leer PDFs de dieta/plan
# con IA. Opcional igual que ESRI_API_KEY: sin ella esa ruta responde 503
# con un mensaje claro, el resto de la app funciona igual. NUNCA debe
# llegar al frontend.
ANTHROPIC_API_KEY=
